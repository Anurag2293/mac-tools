#!/bin/bash
[ -n "${FERRY_TEST_LOG:-}" ] || { echo "fake sips run outside the test sandbox" >&2; exit 99; }
echo "sips $*" >> "$FERRY_TEST_LOG"
out=""
for ((i = 1; i <= $#; i++)); do
  if [ "${!i}" = "--out" ]; then j=$((i + 1)); out="${!j}"; fi
done
[ -n "$out" ] && printf CONVERTED > "$out"
exit 0
