#!/bin/bash
[ -n "${FERRY_TEST_LOG:-}" ] || { echo "fake keytool run outside the test sandbox" >&2; exit 99; }
echo "keytool $*" >> "$FERRY_TEST_LOG"
ks=""
for ((i = 1; i <= $#; i++)); do
  if [ "${!i}" = "-keystore" ]; then j=$((i + 1)); ks="${!j}"; fi
done
case "$1" in
  -genkeypair) echo fake-keystore > "$ks" ;;
  -list) echo "ferry, Nov 18, 2026, PrivateKeyEntry," ;;
esac
exit 0
